# =============================================================================
# Git Ignore - Juice Corner BD (Proyecto Integrador I)
# =============================================================================

# Datasets y Archivos Masivos (>100MB superan el límite de GitHub)
dataset/*.csv
dataset/*.zip
dataset/*.rar
dataset/*.7z
dataset/*.tar.gz
*.csv.gz

# Bases de Datos Locales y Archivos Binarios de SQL Server
*.mdf
*.ldf
*.ndf
*.bak
*.trn

# Logs y Archivos Temporales de Ejecución
*.log
*.tmp
*.temp
error.txt
output.txt

# Entornos Virtuales y Caché de Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# Sistema Operativo
Thumbs.db
Desktop.ini
.DS_Store

# IDE / VS Code
.vscode/*
!.vscode/settings.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates
